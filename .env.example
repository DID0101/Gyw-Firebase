# Copy to `.env` for local development (not committed).
EXPO_PUBLIC_SENTRY_DSN=

# AdMob native ad unit for the Stories ring feed (Android). Uses Google test IDs when unset.
# EXPO_PUBLIC_ADMOB_ANDROID_STORY_NATIVE_AD_UNIT_ID=ca-app-pub-xxxxxxxx/xxxxxxxx

# Dev phone login bypass when Play Integrity fails (debug builds only).
# Format: +PHONE:CODE pairs comma-separated.
# Dev-only: fixed OTP codes without SMS or reCAPTCHA (comma-separated phone:code).
# Example: EXPO_PUBLIC_DEV_PHONE_CODES=+905369936898:123456
EXPO_PUBLIC_DEV_PHONE_CODES=

# Firebase Console test numbers (Auth → Phone → test numbers) — comma-separated E.164.
# Example: EXPO_PUBLIC_FIREBASE_TEST_PHONES=+16505551234
EXPO_PUBLIC_FIREBASE_TEST_PHONES=
