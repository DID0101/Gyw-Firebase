{
  "expo": {
    "name": "Gyw",
    "owner": "ddr10",
    "slug": "gyw",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gyw_fox_logo.png",
    "scheme": "gyw",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tropicolx.signal-clone",
      "bitcode": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "voip",
          "remote-notification"
        ],
        "NSMicrophoneUsageDescription": "$(PRODUCT_NAME) needs microphone access for voice and video calls.",
        "NSCameraUsageDescription": "$(PRODUCT_NAME) needs camera access for video calls.",
        "NSContactsUsageDescription": "$(PRODUCT_NAME) uses your contacts to suggest people you know who are already on the app. Phone numbers are matched securely.",
        "LSApplicationQueriesSchemes": [
          "maps",
          "comgooglemaps",
          "googlemaps"
        ]
      },
      "entitlements": {
        "com.apple.developer.pushkit.voip": true,
        "aps-environment": "development",
        "com.apple.developer.pushnotification-triggering": true
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gyw_fox_logo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.READ_PHONE_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "com.google.android.gms.permission.AD_ID"
      ],
      "package": "com.gyw1.chat",
      "versionCode": 61,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/gyw_fox_logo.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/gyw_fox_logo.png",
          "color": "#e85d04",
          "sounds": [
            "./assets/sounds/message_sound.wav"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/gyw_fox_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "$(PRODUCT_NAME) would like to use your microphone for voice recording."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "$(PRODUCT_NAME) would like to use your camera to share image or video in a message.",
          "photosPermission": "$(PRODUCT_NAME) would like to use your device gallery to attach image or video in a message."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "$(PRODUCT_NAME) uses your location only when you share it in a chat.",
          "locationAlwaysAndWhenInUsePermission": "$(PRODUCT_NAME) uses your location only when you share it in a chat."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "$(PRODUCT_NAME) would like access to your photo gallery to share image or video in a message.",
          "savePhotosPermission": "$(PRODUCT_NAME) would like to save photos and videos to your photo gallery after downloading from a message."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics",
      "@react-native-firebase/perf",
      "@react-native-firebase/auth",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "$(PRODUCT_NAME) requires camera access in order to capture and transmit video",
          "microphonePermission": "$(PRODUCT_NAME) requires microphone access in order to capture and transmit audio"
        }
      ],
      "expo-web-browser",
      "@react-native-firebase/messaging",
      "./plugins/withAndroidIncomingCall",
      "./plugins/withAndroidChatKeyboardResize",
      "./plugins/withAndroidAdIdPermission",
      "./plugins/withIosVoIP",
      "./plugins/withAndroidFirebasePhoneAuthStable",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "gyw"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-9450348713978628~3244677218",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://serverless-token-api.vercel.app/privacy-policy",
      "eas": {
        "projectId": "4d1aa22a-7531-4d6c-8967-62d6d176abeb"
      }
    }
  }
}
