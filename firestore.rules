rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════════
// GYW Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════════
//
// Call state-machine enforcement
// ───────────────────────────────
//   Valid client-writable transitions:
//     ringing   → answered   (calleeId only)
//     ringing   → declined   (calleeId only)
//     ringing   → busy       (calleeId only)
//     ringing   → ended      (callerId only — cancel before answer)
//     answered  → connecting (either party)
//     connecting → active    (either party)
//     active    → ended      (either party)
//
//   Server-only (Admin SDK bypasses rules):
//     ringing → missed
//
// Immutable call fields (cannot change after creation):
//   callId, callerId, calleeId, callType, chatId, isRandom,
//   ringTimeoutSecs, createdAt, expiresAt, deleteAfter
// ═══════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Shared helpers ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // ── users/{userId} ──────────────────────────────────────────────────────

    match /users/{userId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && uid() == userId;
      allow delete: if isSignedIn() && uid() == userId;

      // ── users/{userId}/callHistory/{entryId} ────────────────────────────
      //
      // Written exclusively by the onCallTerminal Cloud Function via Admin SDK.
      // Clients may only read their own history.  No client writes allowed.
      match /callHistory/{entryId} {
        allow read:             if isSignedIn() && uid() == userId;
        allow create, update,
              delete:           if false;  // Admin SDK only
      }
    }

    // ── chats/{chatId} ──────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && resource != null
        && uid() in resource.data.participants;

      allow create: if isSignedIn()
        && request.resource.data.participants != null
        && uid() in request.resource.data.participants;

      allow update: if isSignedIn()
        && resource != null
        && uid() in resource.data.participants;

      allow delete: if isSignedIn()
        && resource != null
        && uid() in resource.data.participants;

      match /messages/{messageId} {
        function chatParticipants() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow read: if isSignedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && uid() in chatParticipants();

        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && request.resource.data.senderId != null
          && uid() in chatParticipants()
          && (uid() == request.resource.data.senderId
              || request.resource.data.type == 'call');

        allow update: if isSignedIn()
          && resource != null
          && resource.data.senderId != null
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && uid() in chatParticipants()
          && (uid() == resource.data.senderId
              || (request.resource.data.senderId == resource.data.senderId
                  && request.resource.data.type   == resource.data.type
                  && request.resource.data.chatId == resource.data.chatId));

        allow delete: if isSignedIn()
          && resource != null
          && uid() == resource.data.senderId;
      }
    }

    // ── calls/{callId} ──────────────────────────────────────────────────────

    match /calls/{callId} {

      // ── Read — caller or callee only ─────────────────────────────────────
      allow read: if isSignedIn()
        && resource != null
        && (uid() == resource.data.callerId
            || uid() == resource.data.calleeId);

      // ── Create — caller only; status must start as "ringing" ─────────────
      allow create: if isSignedIn()
        && request.resource.data.callerId  != null
        && request.resource.data.calleeId  != null
        && uid() == request.resource.data.callerId
        && request.resource.data.callerId  != request.resource.data.calleeId
        && request.resource.data.status    == 'ringing'
        && request.resource.data.keys().hasAll([
             'callId', 'callerId', 'calleeId', 'callType',
             'status', 'createdAt', 'updatedAt', 'expiresAt', 'deleteAfter'
           ]);

      // ── Update — state-machine transitions ───────────────────────────────
      allow update: if isSignedIn()
        && resource != null
        && _callImmutableFieldsPreserved()
        && _callValidTransition();

      // ── Delete — caller or callee (soft-delete via status is preferred) ──
      allow delete: if isSignedIn()
        && resource != null
        && (uid() == resource.data.callerId
            || uid() == resource.data.calleeId);
    }

    // ── State-machine helper functions ────────────────────────────────────

    function _callIsCaller() {
      return uid() == resource.data.callerId;
    }

    function _callIsCallee() {
      return uid() == resource.data.calleeId;
    }

    function _callIsParticipant() {
      return _callIsCaller() || _callIsCallee();
    }

    function _callImmutableFieldsPreserved() {
      // These fields are written once at creation and must never change.
      let immutable = [
        'callId', 'callerId', 'calleeId', 'callType',
        'chatId', 'isRandom', 'ringTimeoutSecs',
        'createdAt', 'expiresAt', 'deleteAfter'
      ];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(immutable);
    }

    function _callValidTransition() {
      let from = resource.data.status;
      let to   = request.resource.data.status;

      // ringing → answered     (callee accepts)
      return (from == 'ringing'    && to == 'answered'   && _callIsCallee())
        // ringing → declined     (callee rejects)
        || (from == 'ringing'    && to == 'declined'   && _callIsCallee())
        // ringing → busy         (callee already in a call)
        || (from == 'ringing'    && to == 'busy'        && _callIsCallee())
        // ringing → ended        (caller cancels before answer)
        || (from == 'ringing'    && to == 'ended'       && _callIsCaller())
        // answered → connecting  (either — WebRTC setup starts)
        || (from == 'answered'   && to == 'connecting'  && _callIsParticipant())
        // connecting → active    (either — ICE connected)
        || (from == 'connecting' && to == 'active'      && _callIsParticipant())
        // active → ended         (either hangs up)
        || (from == 'active'     && to == 'ended'       && _callIsParticipant());
      // NOTE: ringing → missed is intentionally absent — Admin SDK only.
    }

    // ── callSignaling/{callId}/messages/{messageId} ─────────────────────────

    match /callSignaling/{callId}/messages/{messageId} {

      function _signalingCallParticipant() {
        return exists(/databases/$(database)/documents/calls/$(callId))
          && (uid() == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
              || uid() == get(/databases/$(database)/documents/calls/$(callId)).data.calleeId);
      }

      allow read: if isSignedIn() && _signalingCallParticipant();

      allow create, update: if isSignedIn()
        && _signalingCallParticipant()
        && request.resource.data.from == uid();

      allow delete: if isSignedIn() && _signalingCallParticipant();
    }

    // ── callLinks/{linkId} ──────────────────────────────────────────────────

    match /callLinks/{linkId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.creatorId != null
        && uid() == request.resource.data.creatorId;

      allow update: if isSignedIn()
        && resource != null
        && (uid() == resource.data.creatorId
            || (request.resource.data.participants != null
                && uid() in request.resource.data.participants));

      allow delete: if isSignedIn()
        && resource != null
        && uid() == resource.data.creatorId;
    }

    // ── userTokens/{userId} ─────────────────────────────────────────────────

    match /userTokens/{userId} {
      // Owner read; no delete (prevents accidental token loss).
      allow read:           if isSignedIn() && uid() == userId;
      allow create, update: if isSignedIn() && uid() == userId;
      allow delete:         if false;

      // Per-device token records
      match /devices/{deviceId} {
        allow read, create,
              update, delete: if isSignedIn() && uid() == userId;
      }
    }

    // ── stories/{storyId} ───────────────────────────────────────────────────

    match /stories/{storyId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.userId != null
        && uid() == request.resource.data.userId
        && request.resource.data.keys().hasAll([
             'userId', 'mediaUrl', 'mediaType', 'createdAt',
             'expiresAt', 'viewers', 'likes'
           ]);

      allow update: if isSignedIn()
        && resource != null
        && (uid() == resource.data.userId
            || (request.resource.data.userId    == resource.data.userId
                && request.resource.data.mediaUrl  == resource.data.mediaUrl
                && request.resource.data.mediaType == resource.data.mediaType
                && request.resource.data.createdAt == resource.data.createdAt
                && request.resource.data.expiresAt == resource.data.expiresAt
                && request.resource.data.caption   == resource.data.caption
                && (uid() in request.resource.data.viewers
                    || uid() in request.resource.data.likes)));

      allow delete: if isSignedIn()
        && resource != null
        && uid() == resource.data.userId;
    }

    // ── reports/{reportId} ──────────────────────────────────────────────────

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == uid();
      allow read, update, delete: if false;
    }

    // ── randomQueue/{queueId} ───────────────────────────────────────────────

    match /randomQueue/{queueId} {
      allow create, update, delete: if isSignedIn() && uid() == queueId;
      allow read:                   if isSignedIn() && uid() == queueId;
    }

  }
}
