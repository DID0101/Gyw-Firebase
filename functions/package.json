{
  "name": "functions",
  "description": "Firebase Cloud Functions (do not add \"gyw\" file:.. here — it breaks deploy discovery).",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions",
    "deploy:functions": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions",
    "deploy:function": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions",
    "deploy:onCallCreated": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions:default:onCallCreated",
    "deploy:onCallUpdated": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions:default:onCallUpdated",
    "deploy:onCallCreatedAndTestFcm": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions:default:onCallCreated,functions:default:testFcmSend",
    "deploy:fast": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "gyw": "file:.."
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "^5.3.0"
  },
  "private": true
}
