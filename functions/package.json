{
  "name": "functions",
  "description": "Firebase Cloud Functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions",
    "deploy:functions": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions",
    "deploy:function": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions",
    "deploy:fast": "firebase deploy --only functions",
    "deploy:noAi": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions:rejectCallAnon,functions:markStaleRingingCallsMissed,functions:tryRandomMatch,functions:checkSkipRateLimit,functions:checkAndBanFromReports,functions:cleanupRandomQueue,functions:gywAiReplyV1,functions:gywAiMultimodalV1,functions:gywAiHealthV1,functions:initiateCall,functions:endCall,functions:removeGroupMember,functions:createGroupV1,functions:leaveGroupV1,functions:addGroupMembersV1,functions:updateGroupInfoV1",
    "deploy:call": "cross-env FUNCTIONS_DISCOVERY_TIMEOUT=120 firebase deploy --only functions:initiateCall,functions:endCall",
    "logs": "firebase functions:log",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "apn": "^2.2.0",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.2.2",
    "gyw": "file:..",
    "openai": "^6.35.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "typescript": "^5.3.0"
  },
  "private": true,
  "version": "1.0.0"
}
