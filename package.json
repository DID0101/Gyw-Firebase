  "scripts": {
    "postinstall": "patch-package && node scripts/fix-css-interop.js || exit 0",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:community": "cross-env EXPO_USE_COMMUNITY_AUTOLINKING=1 expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:android": "eas build --platform android --profile production",
